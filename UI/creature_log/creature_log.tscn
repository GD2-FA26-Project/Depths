[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://UI/creature_log/creature_log.gd" id="1"]
[ext_resource type="Texture2D" path="res://UI/creature_log/placeholders/crab.svg" id="2"]

[node name="CreatureLog" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 60

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 60
text = "CREATURE LOG"

[node name="Content" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 40

[node name="CreatureList" type="ItemList" parent="Margin/Column/Content"]
custom_minimum_size = Vector2(480, 0)
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 36
theme_override_constants/v_separation = 24

[node name="Details" type="VBoxContainer" parent="Margin/Column/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 20

[node name="PicturePanel" type="PanelContainer" parent="Margin/Column/Content/Details"]
custom_minimum_size = Vector2(0, 380)
layout_mode = 2

[node name="Picture" type="TextureRect" parent="Margin/Column/Content/Details/PicturePanel"]
layout_mode = 2
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5

[node name="CreatureName" type="Label" parent="Margin/Column/Content/Details"]
layout_mode = 2
theme_override_font_sizes/font_size = 44
text = "CRAB"

[node name="Description" type="RichTextLabel" parent="Margin/Column/Content/Details"]
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 30
text = "Select a creature to read its research notes."

[node name="BackButton" type="Button" parent="Margin/Column"]
custom_minimum_size = Vector2(340, 72)
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 32
text = "BACK TO BASE"

[connection signal="item_selected" from="Margin/Column/Content/CreatureList" to="." method="_on_creature_selected"]
[connection signal="pressed" from="Margin/Column/BackButton" to="." method="_on_back_pressed"]
