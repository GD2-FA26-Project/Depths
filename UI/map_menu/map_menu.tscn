[gd_scene format=3]

[ext_resource type="Script" path="res://UI/map_menu/cell_map.gd" id="1"]

[sub_resource type="Theme" id="Theme_menu"]
default_font_size = 28

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_page"]
bg_color = Color(0.14, 0.14, 0.14, 1)

[node name="MapMenu" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_menu")
theme_override_styles/panel = SubResource("StyleBoxFlat_page")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 60

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 52
text = "MAP"

[node name="Info" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="CurrentCell" type="Label" parent="Margin/Column/Info"]
layout_mode = 2
size_flags_horizontal = 3
text = "Current cell: —"

[node name="LayoutNote" type="Label" parent="Margin/Column/Info"]
layout_mode = 2
text = "Draft cell layout"

[node name="MapPanel" type="PanelContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="CellMap" type="Control" parent="Margin/Column/MapPanel"]
custom_minimum_size = Vector2(0, 420)
layout_mode = 2
mouse_filter = 2
script = ExtResource("1")

[node name="Footer" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Legend" type="Label" parent="Margin/Column/Footer"]
layout_mode = 2
size_flags_horizontal = 3
text = "YOU = current cell    |    Lines = connected cells"

[node name="CloseButton" type="Button" parent="Margin/Column/Footer"]
custom_minimum_size = Vector2(380, 72)
layout_mode = 2
text = "CLOSE  (M / ESC)"
