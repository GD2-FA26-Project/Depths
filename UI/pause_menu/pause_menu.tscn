[gd_scene format=3]

[sub_resource type="Theme" id="Theme_menu"]
default_font_size = 28

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_page"]
bg_color = Color(0.14, 0.14, 0.14, 1)

[node name="PauseMenu" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_menu")
theme_override_styles/panel = SubResource("StyleBoxFlat_page")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 60

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 52
text = "DIVE MENU"

[node name="Stats" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 64

[node name="Depth" type="Label" parent="Margin/Column/Stats"]
layout_mode = 2
text = "Depth: 0 m"

[node name="Resources" type="Label" parent="Margin/Column/Stats"]
layout_mode = 2
text = "Resources: 0"

[node name="Content" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 28

[node name="Objectives" type="PanelContainer" parent="Margin/Column/Content"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Margin" type="MarginContainer" parent="Margin/Column/Content/Objectives"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 28

[node name="Column" type="VBoxContainer" parent="Margin/Column/Content/Objectives/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Margin/Column/Content/Objectives/Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "CURRENT OBJECTIVES"

[node name="Scroll" type="ScrollContainer" parent="Margin/Column/Content/Objectives/Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ObjectivesText" type="Label" parent="Margin/Column/Content/Objectives/Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
text = "Explore the level.\n\nReturn to the surface base."
autowrap_mode = 2

[node name="Items" type="PanelContainer" parent="Margin/Column/Content"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Margin" type="MarginContainer" parent="Margin/Column/Content/Items"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 28

[node name="Column" type="VBoxContainer" parent="Margin/Column/Content/Items/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Margin/Column/Content/Items/Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "COLLECTED ITEMS"

[node name="ItemsList" type="ItemList" parent="Margin/Column/Content/Items/Margin/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="Buttons" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="ResumeButton" type="Button" parent="Margin/Column/Buttons"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
text = "RESUME  (ESC)"

[node name="MapButton" type="Button" parent="Margin/Column/Buttons"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
text = "MAP  (M)"

[node name="SurfaceButton" type="Button" parent="Margin/Column/Buttons"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
text = "RETURN TO SURFACE BASE"
